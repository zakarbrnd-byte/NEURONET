# Backend base URL used by the React observatory.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:3000

# Production GitHub Pages build uses the repository Actions variable:
#   VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Set it in GitHub → Settings → Secrets and variables → Actions → Variables

# Optional backend settings (Rust process environment):
# PORT=3000
# NEURONET_PORT=3000
# NEURONET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://zakarbrnd-byte.github.io
